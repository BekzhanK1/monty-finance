DATABASE_URL=postgresql://postgres:postgres@db:5432/...

JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

TELEGRAM_BOT_TOKEN=...
OPENAI_API_KEY=your-openai-api-key

# Journal: Fernet key for entries at rest. Required in PROD (journal answers 503 without it).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes existing entries unreadable — back it up.
JOURNAL_ENCRYPTION_KEY=

ALLOWED_TELEGRAM_IDS=[...]

# Dev-only: bypass Telegram login (never enable in production)
ENABLE_DEV_AUTH=false
DEV_AUTH_USER_ID=1

# Siri Shortcut integration (Basic Auth)
SIRI_BASIC_AUTH_USERNAME=
SIRI_BASIC_AUTH_PASSWORD=
